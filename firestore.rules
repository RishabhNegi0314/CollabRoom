rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCollabState(data) {
      return data.keys().hasAll(['files', 'users', 'git', 'tasks', 'canvasElements'])
        && data.keys().size() == 5
        && data.files is list
        && data.users is list
        && data.git is map
        && data.tasks is list
        && data.canvasElements is list;
    }

    match /workspaces/{workspaceId} {
      allow read, write: if isValidId(workspaceId);
    }
  }
}
